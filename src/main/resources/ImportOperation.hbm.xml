<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-mapping PUBLIC
        "-//Hibernate/Hibernate Mapping DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-mapping-3.0.dtd">

<hibernate-mapping package="ru.itmo.model">
    <class name="ru.itmo.model.ImportOperation" table="import_operations">
        <cache usage="nonstrict-read-write" region="ru.itmo.model.ImportOperation"/>
        <id name="id" type="java.lang.Long">
            <column name="id"/>
            <generator class="identity"/>
        </id>

        <property name="status" type="java.lang.String">
            <column name="status" length="20" not-null="true"/>
        </property>

        <property name="addedCount" type="java.lang.Integer">
            <column name="added_count"/>
        </property>

        <property name="message" type="java.lang.String">
            <column name="message" sql-type="text"/>
        </property>

        <property name="timestamp" type="java.time.LocalDateTime">
            <column name="created_at" not-null="true"/>
        </property>

        <property name="filename" type="java.lang.String">
            <column name="filename" length="255"/>
        </property>

        <property name="s3key" type="java.lang.String">
            <column name="s3key" length="500"/>
        </property>
    </class>
</hibernate-mapping>
